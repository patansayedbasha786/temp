
#include <stdio.h>
#include <limits.h>

int n;
int cost[20][20];
int visited[20];
int path[20];
int bestPath[21];

int minCost = INT_MAX;

void tsp(int city, int count, int currCost)
{
	int i;
    if (count == n)
    {
        if (cost[city][0] != 0)
        {
            int totalCost = currCost + cost[city][0];

            if (totalCost < minCost)
            {
                minCost = totalCost;

                for ( i = 0; i < n; i++)
                    bestPath[i] = path[i];

                bestPath[n] = 0;
            }
        }
        return;
    }

    for ( i = 0; i < n; i++)
    {
        if (!visited[i] && cost[city][i] != 0)
        {
            int newCost = currCost + cost[city][i];

            if (newCost >= minCost)
                continue;

            visited[i] = 1;
            path[count] = i;

            tsp(i, count + 1, newCost);

            // Backtracking
            visited[i] = 0;
        }
    }
}

int main()
{
	int i,j;
    printf("Enter number of hospitals: ");
    scanf("%d", &n);

    if (n < 1 || n > 20)
    {
        printf("Invalid number of hospitals\n");
        return 0;
    }

    printf("Enter the distance matrix:\n");

    for (i = 0; i < n; i++)
    {
        for ( j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize variables
    minCost = INT_MAX;

    for ( i = 0; i < n; i++)
        visited[i] = 0;

    // Start from hospital 1 (index 0)
    visited[0] = 1;
    path[0] = 0;

    // Call TSP function
    tsp(0, 1, 0);

    // Display result
    if (minCost == INT_MAX)
    {
        printf("No valid tour exists\n");
    }
    else
    {
        printf("Minimum Travel Distance: %d\n", minCost);

        printf("Shortest Route: ");

        for ( i = 0; i <= n; i++)
            printf("%d ", bestPath[i] + 1);

        printf("\n");
    }

    return 0;
}
