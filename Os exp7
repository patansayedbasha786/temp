#include <stdio.h>

#define MAX 50

void firstFit(int blocks[], int m, int process[], int n)
{
    int b[MAX], allocation[MAX];

    for (int i = 0; i < m; i++)
        b[i] = blocks[i];

    for (int i = 0; i < n; i++)
        allocation[i] = -1;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            if (b[j] >= process[i])
            {
                allocation[i] = j;
                b[j] -= process[i];
                break;
            }
        }
    }

    printf("\nFIRST FIT ALLOCATION\n");
    printf("Process\tSize\tBlock\n");

    for (int i = 0; i < n; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d\tB%d\n", i + 1,
                   process[i], allocation[i] + 1);
        else
            printf("P%d\t%d\tNot Allocated\n",
                   i + 1, process[i]);
    }

    printf("\nRemaining Memory:\n");

    for (int i = 0; i < m; i++)
        printf("Block B%d: %d\n", i + 1, b[i]);
}

void bestFit(int blocks[], int m, int process[], int n)
{
    int b[MAX];

    for (int i = 0; i < m; i++)
        b[i] = blocks[i];

    for (int i = 0; i < n; i++)
        allocation[i] = -1;

    for (int i = 0; i < n; i++)
    {
        int best = -1;

        for (int j = 0; j < m; j++)
        {
            if (b[j] >= process[i])
            {
                if (best == -1 || b[j] < b[best])
                    best = j;
            }
        }

        if (best != -1)
        {
            allocation[i] = best;
            b[best] -= process[i];
        }
    }

    printf("\nBEST FIT ALLOCATION\n");
    printf("Process\tSize\tBlock\n");

    for (int i = 0; i < n; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d\tB%d\n", i + 1,
                   process[i], allocation[i] + 1);
        else
            printf("P%d\t%d\tNot Allocated\n",
                   i + 1, process[i]);
    }

    printf("\nRemaining Memory:\n");

    for (int i = 0; i < m; i++)
        printf("Block B%d: %d\n", i + 1, b[i]);
}

void worstFit(int blocks[], int m, int process[], int n)
{
    int b[MAX], allocation[MAX];

    for (int i = 0; i < m; i++)
        b[i] = blocks[i];

    for (int i = 0; i < n; i++)
        allocation[i] = -1;

    for (int i = 0; i < n; i++)
    {
        int worst = -1;

        for (int j = 0; j < m; j++)
        {
            if (b[j] >= process[i])
            {
                if (worst == -1 || b[j] > b[worst])
                    worst = j;
            }
        }

        if (worst != -1)
        {
            allocation[i] = worst;
            b[worst] -= process[i];
        }
    }

    printf("\nWORST FIT ALLOCATION\n");
    printf("Process\tSize\tBlock\n");

    for (int i = 0; i < n; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d\tB%d\n", i + 1,
                   process[i], allocation[i] + 1);
        else
            printf("P%d\t%d\tNot Allocated\n",
                   i + 1, process[i]);
    }

    printf("\nRemaining Memory:\n");

    for (int i = 0; i < m; i++)
        printf("Block B%d: %d\n", i + 1, b[i]);
}

int main()
{
    int blocks[MAX], process[MAX];
    int m, n;

    printf("Enter number of memory blocks: ");
    scanf("%d", &m);

    if (m <= 0 || m < MAX)
    {
        printf("Invalid number of memory blocks.\n");
        return 1;
    }

    printf("Enter memory block sizes:\n");

    for (int i = 0; i < m; i++)
        scanf("%d", &blocks[i]);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
    {
        printf("Invalid number of processes.\n");
        return 1;
    }

    printf("Enter process sizes:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &process[i]);

    firstFit(blocks, m, process, n);
    bestFit(blocks, m, process, n);
    worstFit(blocks, m, process, n);

    return 0;
}
