#include <stdio.h>
int main()
{
int n, i, j, start, length;
char fname[20];
 
printf("Enter number of files: ");
scanf("%d", &n);
 
printf("\nFile Allocation Table\n");
printf("---------------------------------------------------------\n");
printf("File Name\tStart Block\tLength\tAllocated Blocks\n");
printf("---------------------------------------------------------\n");
 
for(i=0; i<n; i++)
{
printf("\nEnter file name: ");
scanf("%s", fname);
 
printf("Enter starting block: ");
scanf("%d", &start);
 
printf("Enter length (number of blocks): ");
scanf("%d", &length);
 
printf("%s\t\t%d\t\t%d\t", fname, start, length);
 
for(j=start; j<start+length; j++)
printf("%d ", j);
 
printf("(Allocated)\n");
}
 
return 0;
}
