#include <stdio.h>

#define MAX 100

void FIFO(int pages[], int n, int frames)
{
    int frame[MAX], i, j, k = 0;
    int faults = 0, hits = 0, found;

    for (i = 0; i < frames; i++)
        frame[i] = -1;

    printf("\n--- FIFO PAGE REPLACEMENT ---\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found)
            hits++;
        else
        {
            frame[k] = pages[i];
            k = (k + 1) % frames;
            faults++;
        }

        printf("Page %d: ", pages[i]);

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == -1)
                printf("- ");
            else
                printf("%d ", frame[j]);
        }

        if (found)
            printf("(Hit)");
        else
            printf("(Fault)");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", faults);
    printf("Total Page Hits = %d\n", hits);
}

int main()
{
    int pages[MAX], n, frames, i;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
        return 1;

    printf("Enter the page reference string:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    if (frames <= 0 || frames > MAX)
        return 1;

    FIFO(pages, n, frames);

    return 0;
}





#include <stdio.h>

#define MAX 100

void LRU(int pages[], int n, int frames)
{
    int frame[MAX], time[MAX];
    int i, j, pos, found;
    int faults = 0, hits = 0;
    int counter = 0;

    for (i = 0; i < frames; i++)
    {
        frame[i] = -1;
        time[i] = 0;
    }

    printf("\n--- LRU PAGE REPLACEMENT ---\n");

    for (i = 0; i < n; i++)
    {
        found = 0;
        counter++;

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                time[j] = counter;
                break;
            }
        }

        if (found)
            hits++;
        else
        {
            pos = -1;

            for (j = 0; j < frames; j++)
            {
                if (frame[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if (pos == -1)
            {
                pos = 0;

                for (j = 1; j < frames; j++)
                {
                    if (time[j] < time[pos])
                        pos = j;
                }
            }

            frame[pos] = pages[i];
            time[pos] = counter;
            faults++;
        }

        printf("Page %d: ", pages[i]);

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == -1)
                printf("- ");
            else
                printf("%d ", frame[j]);
        }

        if (found)
            printf("(Hit)");
        else
            printf("(Fault)");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", faults);
    printf("Total Page Hits = %d\n", hits);
}

int main()
{
    int pages[MAX], n, frames, i;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
        return 1;

    printf("Enter the page reference string:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    if (frames <= 0 || frames > MAX)
        return 1;

    LRU(pages, n, frames);

    return 0;
}




#include <stdio.h>

#define MAX 100

void Optimal(int pages[], int n, int frames)
{
    int frame[MAX], i, j, k;
    int faults = 0, hits = 0;
    int found, pos, farthest, next;

    for (i = 0; i < frames; i++)
        frame[i] = -1;

    printf("\n--- OPTIMAL PAGE REPLACEMENT ---\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found)
            hits++;
        else
        {
            pos = -1;

            for (j = 0; j < frames; j++)
            {
                if (frame[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if (pos == -1)
            {
                farthest = -1;

                for (j = 0; j < frames; j++)
                {
                    next = n + 1;

                    for (k = i + 1; k < n; k++)
                    {
                        if (pages[k] == frame[j])
                        {
                            next = k;
                            break;
                        }
                    }

                    if (next > farthest)
                    {
                        farthest = next;
                        pos = j;
                    }
                }
            }

            frame[pos] = pages[i];
            faults++;
        }

        printf("Page %d: ", pages[i]);

        for (j = 0; j < frames; j++)
        {
            if (frame[j] == -1)
                printf("- ");
            else
                printf("%d ", frame[j]);
        }

        if (found)
            printf("(Hit)");
        else
            printf("(Fault)");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", faults);
    printf("Total Page Hits = %d\n", hits);
}

int main()
{
    int pages[MAX], n, frames, i;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
        return 1;

    printf("Enter the page reference string:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    if (frames <= 0 || frames > MAX)
